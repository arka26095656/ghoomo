# Copy the values you need into your shell, IDE run config, or Render/Koyeb environment.
# Nothing here is required for a local demo: without keys the app runs on the offline mock planner.

# --- AI (get free keys: aistudio.google.com and console.groq.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_MOCK_FALLBACK=true
# Which provider goes first, and how long each may take before the next one is tried
AI_PROVIDER_ORDER=gemini,groq
GEMINI_TIMEOUT_SECONDS=25
GROQ_TIMEOUT_SECONDS=60

# --- Database (omit for in-memory H2) ---
# Supabase/Neon give a postgres:// URL; convert it to JDBC form:
# DATABASE_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Security ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:5173

# --- Optional ---
CHAT_RATE_PER_MINUTE=8
TRAVEL_USER_AGENT=Ghoomo/0.1 (you@example.com)
